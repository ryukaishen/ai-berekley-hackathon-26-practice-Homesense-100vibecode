NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# Use a persistent disk or volume in production.
REENTRY_DB_PATH=/data/reentry.sqlite
REENTRY_SEED_DEMO=false

# Optional OpenAI-compatible AI adapter. Leave blank for deterministic no-op fallback.
AI_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional Fitbit OAuth. Leave blank to keep mock wearable import fallback.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=https://your-reentry-api.example.com/fitbit/callback

# Preferred live wearable OAuth path for Fitbit/Pixel Watch data through Google Health API.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=https://your-reentry-api.example.com/google-health/callback

# Web build-time API URL. Vite only exposes client variables prefixed with VITE_.
VITE_API_BASE_URL=https://your-reentry-api.example.com
